---
import { Image } from "astro:assets";
import type { Member } from "../lib/content";
import { memberUrl } from "../lib/content";

export interface Props {
  member: Member;
}
const { member } = Astro.props;
const { name, role, avatar } = member.data;
---

<article class="member">
  <a href={memberUrl(member)}>
    <figure class="headshot">
      {avatar ? <Image src={avatar} alt="" widths={[360, 720]} sizes="(max-width: 720px) 50vw, min(33vw, 360px)" /> : <span class="placeholder">[ photo ]</span>}
    </figure>
    <h3>{name}</h3>
  </a>
  <p>{role}</p>
</article>

<style>
  .member { min-width: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover h3 { text-decoration: underline; text-underline-offset: 3px; }
  .headshot { margin-bottom: var(--space-3); aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); border: 1px solid var(--rule); }
  .headshot img, .headshot .placeholder { width: 100%; height: 100%; object-fit: cover; }
  h3 { margin-bottom: 2px; font: 600 var(--text-h4) / 1.2 var(--font-sans); }
  p { color: var(--soft); font-size: var(--text-small); line-height: 1.45; }
</style>
