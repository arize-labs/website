---
import type { Post } from "../lib/content";
import { postUrl } from "../lib/content";
import PostGrid from "./sections/PostGrid.astro";
import FormattedDate from "./FormattedDate.astro";
import Byline from "./Byline.astro";

export interface Props {
  posts: Post[];
  /** Show this many of the newest posts as cards above the list. */
  featured?: number;
}
const { posts, featured = 0 } = Astro.props;
const cards = posts.slice(0, featured);
const rows = posts.slice(featured);
---

{posts.length === 0 && <p class="empty">No posts yet.</p>}

{cards.length > 0 && <PostGrid posts={cards} headingLevel="h2" />}

{rows.length > 0 && (
  <section class:list={["rows", { "after-cards": cards.length > 0 }]} aria-labelledby={cards.length > 0 ? "more-posts" : undefined}>
    {cards.length > 0 && <h2 id="more-posts" class="eyebrow label">More posts</h2>}
    <ul class="post-rows">
      {rows.map((post) => (
        <li>
          <article class="post-row">
            <p class="eyebrow when">
              <FormattedDate date={post.data.pubDate} />{post.data.tags[0] && <> · {post.data.tags[0]}</>}
            </p>
            {cards.length > 0
              ? <h3 class="title"><a href={postUrl(post)}>{post.data.title}</a></h3>
              : <h2 class="title"><a href={postUrl(post)}>{post.data.title}</a></h2>}
            <p class="by"><Byline authors={post.data.authors} link={false} /></p>
          </article>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .empty { color: var(--dim); }

  .after-cards { margin-top: var(--space-8); }
  .label { margin-bottom: var(--space-4); }

  .post-rows { padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .post-rows li { border-bottom: 1px solid var(--rule); }

  /* Date and tag, title, authors: one line on wide screens. */
  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr) minmax(0, 1fr);
    gap: var(--space-2) var(--space-6);
    align-items: baseline;
    padding: var(--space-5) 0;
  }
  .when { margin: 0; }
  .title { margin: 0; font: 600 var(--text-h4) / 1.3 var(--font-sans); letter-spacing: -0.01em; text-wrap: pretty; }
  .title a { text-decoration: none; }
  /* The whole row is the link target. */
  .title a::after { content: ""; position: absolute; inset: 0; }
  .post-row:hover .title a { color: var(--accent); }
  .by { margin: 0; color: var(--dim); font-size: var(--text-small); text-align: right; }

  @media (max-width: 720px) {
    .after-cards { margin-top: var(--space-7); }
    .post-row { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); padding: var(--space-4) 0; }
    .by { text-align: left; }
  }
</style>
