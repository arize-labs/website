---
import { site } from "../site.config";
import ArizeLogo from "../assets/arize/arize-logo.svg";
import ThemeToggle from "./ThemeToggle.astro";

const year = new Date().getFullYear();
const social = Object.entries(site.social);
---

<footer class="site-footer page-grid">
  <div class="inner">
    <a class="home" href={site.parent.url} aria-label={site.parent.name}>
      <ArizeLogo aria-hidden="true" />
    </a>
    <ul class="links">
      {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href="/brand">Brand</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
    <ul class="links">
      {social.map(([name, href]) => <li><a href={href} rel="me noopener">{name}</a></li>)}
    </ul>
    <div class="legal">
      <p class="eyebrow">© {year} {site.parent.name}</p>
      <ThemeToggle />
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: auto; padding: var(--space-9) 0 var(--space-7); }
  .inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-6) var(--space-7);
    align-items: start;
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }
  /* The official Arize lockup, shown in one colour that follows the theme. */
  .home { justify-self: start; color: var(--fg); }
  .home svg { display: block; width: auto; height: 32px; }
  .home :global(path) { fill: currentColor; }
  .links { display: grid; gap: var(--space-2); padding: 0; list-style: none; }
  .links a {
    color: var(--dim);
    font: 500 var(--text-micro) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    text-decoration: none;
  }
  .links a:hover { color: var(--fg); }
  .legal { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }

  @media (max-width: 720px) {
    .site-footer { padding-top: var(--space-8); }
    .inner { grid-template-columns: 1fr 1fr; }
    .home { grid-column: 1 / -1; }
  }
</style>
