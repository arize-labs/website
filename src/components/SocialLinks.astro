---
/**
 * A row of social icon buttons with an optional mono label in front ("Share",
 * "Follow"). Every social link on the site goes through this, so posts' share
 * buttons and team profiles' links look and behave the same: square, 1px
 * rule, inverting on hover. Plain links that open in a new tab, so they work
 * without JavaScript and load nothing from the other site until clicked.
 */
export type Network = "x" | "linkedin" | "github" | "website";

export interface Props {
  label?: string;
  links: { network: Network; href: string; name: string }[];
  /** Extra rel values, such as "me" for a person's own profiles. */
  rel?: string;
}
const { label, links, rel = "" } = Astro.props;

const ICONS: Record<Network, string> = {
  x: "M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.32l4.37 5.78zm-1.08 16.17h1.7L7.4 4.73H5.58z",
  linkedin:
    "M3.5 9h3.9v12H3.5zM5.45 3a2.25 2.25 0 1 1 0 4.5 2.25 2.25 0 0 1 0-4.5M9.9 9h3.73v1.64h.05c.52-.98 1.79-2.01 3.69-2.01 3.94 0 4.67 2.6 4.67 5.97V21h-3.89v-5.68c0-1.36-.02-3.1-1.89-3.1-1.89 0-2.18 1.48-2.18 3V21H9.9z",
  github:
    "M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5",
  website: "M7 4h13v13h-2.6V8.44L5.84 20 4 18.16 15.56 6.6H7z",
};
---

<span class="social-links">
  {label && <span class="label eyebrow">{label}</span>}
  {links.map((link) => (
    <a href={link.href} target="_blank" rel={`${rel} noopener noreferrer`.trim()} aria-label={link.name} title={link.name}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[link.network]} /></svg>
    </a>
  ))}
</span>

<style>
  .social-links { display: inline-flex; align-items: center; gap: 6px; }
  .label { margin-right: 6px; }
  a { display: grid; place-items: center; width: 26px; height: 26px; border: 1px solid var(--rule); color: var(--fg); }
  a:hover, a:focus-visible { border-color: var(--fg); background: var(--fg); color: var(--bg); }
  svg { width: 13px; height: 13px; fill: currentColor; }
</style>
