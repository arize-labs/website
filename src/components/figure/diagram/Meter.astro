---
/** A horizontal gauge: a textured track and a fill whose width a scene can grow. */
export interface Props {
  x: number;
  y: number;
  w: number;
  h?: number;
  /** Fill fraction in the finished state, 0 to 1. */
  value: number;
  k?: string;
  fill?: "ink" | "accent" | "hatch" | "soft";
  label?: string;
  /** Right-aligned reading above the track. */
  reading?: string;
  readingK?: string;
}
const { x, y, w, h = 8, value, k, fill = "ink", label, reading, readingK } = Astro.props;
---

{label && <text class="d-sub" x={x} y={y - 8}>{label}</text>}
{reading && <text class="d-mono d-dim" x={x + w} y={y - 8} text-anchor="end" data-key={readingK}>{reading}</text>}
<rect class="d-fill-ground" x={x} y={y} width={w} height={h} rx="1" />
<rect class={`d-fill-${fill}`} x={x} y={y} width={Math.max(0, Math.min(1, value)) * w} height={h} rx="1" data-key={k} />
