---
import type { Member } from "../../lib/content";
import MemberCard from "../MemberCard.astro";

export interface Props {
  members: Member[];
}
const { members } = Astro.props;
---

<ul class="team-grid">
  {members.map((member) => <li><MemberCard member={member} /></li>)}
</ul>

<style>
  /* Three up, with the prototype's three-up spacing. */
  .team-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px var(--space-5); padding: 0; list-style: none; }

  @media (max-width: 720px) {
    .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-3); }
  }
</style>
