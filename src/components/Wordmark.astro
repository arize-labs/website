---
// The Arize Labs lockup, sized as a logo. It takes the surrounding text colour.
import BrandArt from "./brand/BrandArt.astro";
---

<BrandArt name="lockup" label="Arize Labs" class="wordmark" />

<style>
  /* 34px matches the prototype header; never below the 24px lockup minimum. */
