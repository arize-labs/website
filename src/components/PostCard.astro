---
import { Image } from "astro:assets";
import type { Post } from "../lib/content";
import { postUrl } from "../lib/content";
import FormattedDate from "./FormattedDate.astro";
import Byline from "./Byline.astro";
import CoverArt from "./art/CoverArt.astro";

export interface Props {
  post: Post;
  /** "card" for grids, "row" for lists. */
  variant?: "card" | "row";
  headingLevel?: "h2" | "h3";
}
const { post, variant = "card", headingLevel: Heading = "h3" } = Astro.props;
const { title, description, pubDate, authors, cover, art, tags } = post.data;
---

<article class:list={["post-card", variant]}>
  <a class="thumb" href={postUrl(post)} tabindex="-1" aria-hidden="true">
    {cover ? <Image src={cover} alt="" widths={[480, 960]} sizes="(max-width: 720px) 104px, 33vw" /> : <CoverArt seed={post.id} kind={art} />}
  </a>
  <div class="text">
    <p class="eyebrow">
      <FormattedDate date={pubDate} />{tags[0] && <> · {tags[0]}</>}
    </p>
    <Heading class="title"><a href={postUrl(post)}>{title}</a></Heading>
    <p class="description">{description}</p>
    <p class="meta"><Byline authors={authors} link={false} /></p>
  </div>
</article>

<style>
  .post-card { min-width: 0; }
  .thumb { display: block; overflow: hidden; text-decoration: none; aspect-ratio: 8 / 5; border: 1px solid var(--rule); }
  .thumb img, .thumb .placeholder { width: 100%; height: 100%; object-fit: cover; }
  .text { margin-top: var(--space-4); }
  .eyebrow { margin-bottom: 6px; }
  .title { margin-bottom: 6px; font: 600 19px / 1.25 var(--font-sans); letter-spacing: -0.01em; }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* Two lines at most, so cards in a row stay even. */
  .description { color: var(--soft); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .meta { margin-top: var(--space-2); color: var(--dim); font-size: var(--text-small); }

  /* Row: thumbnail beside text. Used for lists, and for cards on phones. */
  .row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-6); align-items: start; }
  .row .text { margin-top: 0; }
  .row .title { font-size: var(--text-h3); }

  @media (max-width: 720px) {
    .post-card { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 14px; align-items: start; }
    .thumb { aspect-ratio: 1; }
    .text { margin-top: 0; }
    .title, .row .title { font-size: var(--text-h4); }
    .description { font-size: var(--text-small); line-height: 1.45; }
  }
</style>
