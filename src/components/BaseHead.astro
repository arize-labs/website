---
/**
 * Everything in <head>: the title and description, the canonical URL, and
 * what link previews show (Open Graph, X) and search engines read (JSON-LD).
 *
 * Every page gets a social card: pass `image`, or the page gets its own card
 * from src/lib/og/cards.ts by path, falling back to the site card. Posts
 * pass `article` and, for video posts, `video`.
 */
import { site } from "../site.config";
import { defaultSocialImage, type SocialImage } from "../lib/og/cards";
import { stripBase, withBase } from "../lib/url";
import { markdownRouteOf } from "../integrations/llms-txt.mjs";

export interface Author {
  name: string;
  /** Their page on this site; absolute or root-relative. */
  url?: string;
  /** Their X profile, for twitter:creator. */
  x?: string;
}

export interface SocialVideo {
  /** An MP4 file (video/mp4) or an embeddable player page (text/html). */
  url: string;
  type: "video/mp4" | "text/html";
  width: number;
  height: number;
}

export interface Props {
  title?: string;
  description?: string;
  image?: SocialImage;
  type?: "website" | "article" | "profile";
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    authors: Author[];
    tags?: string[];
  };
  video?: SocialVideo;
  /** schema.org data for the page; the home page describes the WebSite. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /**
   * The page has a markdown copy at its URL plus `.md`, drawn from its
   * `data-markdown` element by src/integrations/llms-txt.mjs; link to it.
   */
  markdown?: boolean;
}

const { title, description = site.description, type = "website", article, video, noindex = false, markdown = false } = Astro.props;

const abs = (url: string) => new URL(url, Astro.site).href;
/** "@handle" from an X profile URL. */
const handle = (url?: string) => {
  const name = url?.match(/(?:x|twitter)\.com\/(\w+)/)?.[1];
  return name ? `@${name}` : undefined;
};

const home = abs(withBase("/"));
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = Astro.props.image ?? defaultSocialImage(Astro.url.pathname, title);
const imageUrl = abs(image.url);
// The page's route with no trailing slash (but the home page's), as its links are written.
const route = withBase(stripBase(Astro.url.pathname).replace(/(.)\/$/, "$1"));
const creator = article?.authors.map((a) => handle(a.x)).find(Boolean);

const jsonLd =
  Astro.props.jsonLd ??
  (stripBase(Astro.url.pathname) === "/"
    ? { "@context": "https://schema.org", "@type": "WebSite", name: site.name, url: home, description: site.description, image: imageUrl }
    : undefined);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href={withBase("/favicon.ico")} sizes="48x48" />
<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
<link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
<link rel="sitemap" href={withBase("/sitemap-index.xml")} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href={abs(withBase("/rss.xml"))} />
{markdown && <link rel="alternate" type="text/markdown" href={markdownRouteOf(route)} />}
<link rel="describedby" type="text/plain" href={withBase("/llms.txt")} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{article && <meta name="author" content={article.authors.map((a) => a.name).join(", ")} />}

<!-- Open Graph: Facebook, LinkedIn, Slack, Discord, iMessage, WhatsApp and most others. -->
<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? site.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={site.ogLocale} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content={image.type} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta property="og:image:alt" content={image.alt} />
{video && (
  <>
    <meta property="og:video" content={abs(video.url)} />
    <meta property="og:video:secure_url" content={abs(video.url)} />
    <meta property="og:video:type" content={video.type} />
    <meta property="og:video:width" content={String(video.width)} />
    <meta property="og:video:height" content={String(video.height)} />
  </>
)}
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article.authors.map((a) => <meta property="article:author" content={a.url ? abs(a.url) : a.name} />)}
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- X reads Open Graph for the rest; these pick the large card and credit the accounts. -->
<meta name="twitter:card" content="summary_large_image" />
{handle(site.social.x) && <meta name="twitter:site" content={handle(site.social.x)} />}
{creator && <meta name="twitter:creator" content={creator} />}
<meta name="twitter:title" content={title ?? site.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={image.alt} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<!-- Set the theme before first paint so there is no flash. A saved "light" or
     "dark" wins; otherwise (Auto) follow the system preference. -->
<script is:inline>
  (() => {
    let saved = null;
    try { saved = localStorage.getItem("theme"); } catch {}
    document.documentElement.dataset.theme =
      saved === "light" || saved === "dark"
        ? saved
        : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  })();
</script>
