---
/** Share buttons for a post: the X and LinkedIn share pages for its URL. */
import SocialLinks from "./SocialLinks.astro";

export interface Props {
  title: string;
}
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
---

<SocialLinks
  markdown={false}
  label="Share"
  links={[
    { network: "x", name: "Share on X", href: `https://x.com/intent/post?${new URLSearchParams({ url, text: title })}` },
    { network: "linkedin", name: "Share on LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?${new URLSearchParams({ url })}` },
  ]}
/>
