---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
import Hero from "../components/sections/Hero.astro";
import HeroPhoto from "../components/heroes/HeroPhoto.astro";
import Section from "../components/sections/Section.astro";
import Pillars from "../components/sections/Pillars.astro";
import FeatureRows from "../components/sections/FeatureRows.astro";
import PostGrid from "../components/sections/PostGrid.astro";
import TeamGrid from "../components/sections/TeamGrid.astro";
import PageMarkings from "../components/PageMarkings.astro";
import type { Run } from "../components/PageMarkings.astro";
import { getPosts, getTeam } from "../lib/content";
import { site } from "../site.config";

const pillars = [
  { name: "Open Tooling", body: "Open-source tools for building agents, with good practices built in." },
  { name: "Open Evals", body: "Published evaluations, with the harness and data behind them, so anyone can check the results." },
  { name: "Open Research", body: "Experiments shared while in progress, with write-ups of what worked and what didn't." },
];

const projects = [
  {
    name: "Arize Phoenix",
    scene: "phoenix" as const,
    href: "https://github.com/Arize-ai/phoenix",
    cta: "View on GitHub",
    body: "An open-source platform for AI observability and evaluation. Phoenix traces agents end to end and turns those traces into context for evaluating and improving them: evaluations run against real agent runs, and what they find becomes datasets, experiments and prompt iterations. It runs locally or self-hosted, and is built on OpenTelemetry.",
  },
  {
    name: "OpenInference",
    scene: "rack" as const,
    href: "https://github.com/Arize-ai/openinference",
    cta: "View on GitHub",
    body: "A set of semantic conventions and instrumentation libraries, complementary to OpenTelemetry, for agent observability. OpenInference defines how LLM calls, retrievals, tool use and agent steps are recorded, and ships auto-instrumentation for popular model providers and frameworks across Python, JavaScript, Java and Go.",
  },
];

// Gutter rulers: from under the hero art to the first project, and from the
// news section into the team grid. The mission pillars belong to the hero
// beat, so their section gets no registration cross.
const rulerRuns: Run[] = [
  { from: [".hero .art", "bottom"], to: ["#projects .feature", "top"], fadeIn: 96, fadeOut: 160 },
  { from: ["#news", "top"], to: ["#team .member", "middle"], fadeIn: 96, fadeOut: 0.4 },
];

const latestPosts = (await getPosts()).slice(0, 3);
// Everyone, in `order`: advisors first, then the technical staff.
const team = await getTeam();
---

<BaseLayout description={site.description}>
  <PageMarkings runs={rulerRuns} marks="main > section:not(#mission)" />
  <Hero heading="An Open Frontier" lede={site.description}>
    <HeroPhoto slot="art" />
  </Hero>

  <Section id="mission" class="mission">
    <Pillars items={pillars} />
  </Section>

  <Section id="projects" heading="Projects" bleed>
    <FeatureRows items={projects} />
  </Section>

  <Section id="news" heading="News" intro="News, writing and resources about the open-source projects.">
    <a slot="action" class="button" href={withBase("/blog")}>All posts</a>
    <PostGrid posts={latestPosts} />
  </Section>

  <Section id="team" heading="Team" intro="The engineers, researchers and designers behind Arize Labs.">
    <a slot="action" class="button" href={withBase("/team")}>Meet the team</a>
    <TeamGrid members={team} />
  </Section>
</BaseLayout>

<style>
  /* The pillars sit close under the hero copy, as one beat. */
  .mission { padding-top: var(--space-9); }
  @media (max-width: 720px) {
    .mission { padding-top: var(--space-8); }
  }
</style>
