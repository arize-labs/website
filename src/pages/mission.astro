---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";

// Copy lives in src/content/pages/mission.md.
const page = await getEntry("pages", "mission");
if (!page) throw new Error("Missing src/content/pages/mission.md");
const { title, description } = page.data;
const { Content } = await render(page);
---

<PageLayout heading={title} intro={description} width="prose">
  <div class="prose manifesto">
    <Content />
  </div>
</PageLayout>

<style>
  /* Each `##` in the Markdown is a principle, numbered 01, 02, 03. */
  .manifesto { counter-reset: principle; }
  .manifesto :global(h2) {
    counter-increment: principle;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }
  .manifesto :global(h2)::before {
    content: counter(principle, decimal-leading-zero);
    display: block;
    margin-bottom: var(--space-3);
    color: var(--accent);
    font: 500 var(--text-micro) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-micro);
  }
  .manifesto :global(h2 + p) { color: var(--soft); }
  .manifesto :global(hr) { margin: var(--space-8) 0 var(--space-6); }

  @media (max-width: 720px) {
    .manifesto :global(h2) { margin-top: var(--space-7); }
  }
</style>
