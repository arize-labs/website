---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/sections/Section.astro";
import BrandArt from "../components/brand/BrandArt.astro";
import {
  INRADIUS,
  SIDE,
  art,
  clearSpace,
  colors,
  lockup,
  mark,
  minimumSize,
  nut,
  triangle,
} from "../lib/brand";

const fmt = (n: number, digits = 1) => String(Number(n.toFixed(digits)));
const pct = (n: number) => `${fmt((n / SIDE) * 100)}%`;
const points = (pts: [number, number][]) => pts.map(([x, y]) => `${fmt(x, 2)},${fmt(y, 2)}`).join(" ");

const contents = [
  ["logo", "Logo"],
  ["mark", "Mark"],
  ["lockup", "Lockup"],
  ["space", "Clear space"],
  ["color", "Colour"],
  ["type", "Typography"],
  ["misuse", "Misuse"],
] as const;

const downloads = [
  { artwork: art.lockup, label: "Lockup" },
  { artwork: art.mark, label: "Mark" },
  { artwork: art.wordmark, label: "Wordmark" },
];

/* C-01: mark construction. */
const tipCutPoint = (() => {
  const [apex, right] = triangle;
  const len = Math.hypot(right[0] - apex[0], right[1] - apex[1]);
  const t = mark.tipCut / len;
  return [apex[0] + (right[0] - apex[0]) * t, apex[1] + (right[1] - apex[1]) * t];
})();

const markDims = [
  { y1: mark.nutApothem, y2: INRADIUS, label: `wall ${fmt(mark.wall)}` },
  { y1: -mark.nutApothem, y2: -mark.boreRadius, label: `gap ${fmt(mark.gap)}` },
];

const markSpec = [
  ["Triangle side", `${SIDE} u`],
  ["Tip cut", `${mark.tipCut} u · ${pct(mark.tipCut)} of side`],
  ["Outer corner radius", `${mark.outerRadius} u`],
  ["Nut across flats", `${fmt(mark.nutApothem * 2)} u · ${pct(mark.nutApothem * 2)}`],
  ["Nut across corners", `${fmt(mark.nutRadiusOuter * 2)} u`],
  ["Nut corner radius", `${mark.nutRadius} u`],
  ["Wall (edge → nut)", `${fmt(mark.wall)} u · ${pct(mark.wall)}`],
  ["Gap (nut → bore)", `${fmt(mark.gap)} u · ${pct(mark.gap)}`],
  ["Bore diameter", `${mark.boreRadius * 2} u · ${pct(mark.boreRadius * 2)}`],
  ["Nut centre", "Incentre"],
];

/* C-02: lockup construction. */
const L = art.lockup.viewBox;
const markRight = art.mark.viewBox.x + art.mark.viewBox.w;
const textLeft = art.wordmark.viewBox.x;
const markTop = lockup.top;
const lockupPad = 90;
const lockupFrame = `${L.x - lockupPad} ${L.y - lockupPad} ${L.w + lockupPad * 2} ${L.h + lockupPad * 2}`;

const lockupSpec = [
  ["Mark height", `${fmt(lockup.markHeight)} u`],
  ["Mark → wordmark gap", `${fmt(lockup.gap, 0)} u`],
  ["Top", "Top of the “r” on mark top"],
  ["Bottom", "Foot of the “l” on mark bottom"],
  ["Wordmark", "Drawn artwork, stacked and centred"],
  ["Lockup aspect", `${fmt(lockup.aspect, 2)} : 1`],
];

/* S-01: clear space. */
const d = clearSpace;
const spaceFrame = `${L.x - d - 30} ${L.y - d - 30} ${L.w + 2 * d + 60} ${L.h + 2 * d + 60}`;
const spaceLabels = [
  [L.x + L.w / 2, L.y - d / 2],
  [L.x + L.w / 2, L.y + L.h + d / 2],
  [L.x - d / 2, L.y + L.h / 2],
  [L.x + L.w + d / 2, L.y + L.h / 2],
];
const ladder = [16, 20, 24, 32, 48, 72, 120];

const swatches = [
  { name: "Ink", hex: colors.ink, class: "ink" },
  { name: "Paper", hex: colors.paper, class: "paper" },
  { name: "White", hex: colors.white, class: "white" },
  { name: "Black", hex: colors.black, class: "black" },
];

const weights = [
  [100, "Thin"],
  [200, "ExtraLight"],
  [300, "Light"],
  [400, "Regular"],
  [500, "Medium"],
  [600, "SemiBold"],
  [700, "Bold"],
  [800, "ExtraBold"],
  [900, "Black"],
] as const;

const misuse = [
  { class: "stretch", caption: "Don’t stretch or squash the lockup" },
  { class: "rotate", caption: "Don’t rotate it" },
  { class: "recolour", caption: "Don’t recolour it" },
  { class: "outline", caption: "Don’t outline the mark", art: "mark" as const },
  { class: "shadow", caption: "Don’t add shadows or effects" },
  { class: "low-contrast", caption: "Don’t place it on low-contrast grounds" },
];
---

<PageLayout
  heading="Brand guidelines"
  eyebrow="Mark & wordmark"
  intro="How to use the Arize Labs mark and lockup. Always start from the artwork files below. Never redraw or retype them."
>
  <nav slot="header" class="contents" aria-label="On this page">
    <ol>
      {contents.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
    </ol>
  </nav>

  <figure class="hero">
    <BrandArt name="lockup" label="Arize Labs" />
  </figure>
  <ul class="downloads" aria-label="Download artwork">
    {downloads.map(({ artwork, label }) => (
      <li><a class="button" href={artwork.url} download={artwork.file}>{label} SVG</a></li>
    ))}
  </ul>
  <p class="note">Files are single-colour black on a transparent ground, with the wordmark drawn as outlines, so they need no font.</p>

  <Section
    id="logo"
    heading="Logo"
    intro="The primary lockup places the mark to the left of the Arize wordmark, with labs set beneath it. Use ink on paper or paper on ink. Use the mark alone in small, square or avatar contexts."
  >
    <div class="grid two">
      <figure class="panel paper"><div class="stage"><BrandArt name="lockup" label="Arize Labs lockup, ink on paper" class="lockup" /></div><figcaption><b>L-01</b> Primary · ink on paper</figcaption></figure>
      <figure class="panel ink"><div class="stage"><BrandArt name="lockup" label="Arize Labs lockup, paper on ink" class="lockup" /></div><figcaption><b>L-02</b> Primary · paper on ink</figcaption></figure>
      <figure class="panel paper"><div class="stage"><BrandArt name="mark" label="Arize Labs mark, ink on paper" class="mark-lg" /></div><figcaption><b>M-01</b> Mark alone · ink on paper</figcaption></figure>
      <figure class="panel ink"><div class="stage"><BrandArt name="mark" label="Arize Labs mark, paper on ink" class="mark-lg" /></div><figcaption><b>M-02</b> Mark alone · paper on ink</figcaption></figure>
    </div>
  </Section>

  <Section
    id="mark"
    heading="Mark"
    intro="An equilateral triangle on a 1000-unit side. The tips are clipped, a hexagonal nut is cut out at the incentre, and a round bore sits inside the nut. Wall, gap and bore are proportions of one another; the triangle is fixed and they scale to fit it."
  >
    <div class="construct">
      <figure class="panel paper">
        <div class="stage tall">
          <svg class="diagram" viewBox="-560 -640 1120 960" role="img" aria-label="Mark construction: triangle, nut and bore guides">
            <BrandArt name="mark" nested class="ghost" />
            <g class="guides">
              <polygon class="dash" points={points(triangle)} />
              <circle r={INRADIUS} />
              <circle r={mark.nutRadiusOuter} />
              <circle r={mark.nutApothem} />
              <line x1={-SIDE / 2 - 30} y1="0" x2={SIDE / 2 + 30} y2="0" />
              <line x1="0" y1={-2 * INRADIUS - 30} x2="0" y2={INRADIUS + 30} />
              <polygon class="strong" points={points(nut)} />
              {markDims.map(({ y1, y2 }) => (
                <g class="strong">
                  <line x1="0" y1={y1} x2="0" y2={y2} />
                  <line x1="-14" y1={y1} x2="14" y2={y1} />
                  <line x1="-14" y1={y2} x2="14" y2={y2} />
                </g>
              ))}
              <line class="strong" x1="0" y1="0" x2={mark.boreRadius} y2="0" />
            </g>
            <g class="labels" font-size="22">
              {markDims.map(({ y1, y2, label }) => <text x="22" y={(y1 + y2) / 2 + 8}>{label}</text>)}
              <text x={mark.boreRadius / 2} y="-10" text-anchor="middle">r {mark.boreRadius}</text>
              <text x={tipCutPoint[0] + 18} y={tipCutPoint[1] - 10}>cut {mark.tipCut}</text>
            </g>
          </svg>
        </div>
        <figcaption><b>C-01</b> Construction</figcaption>
      </figure>
      <table class="spec">
        <caption class="visually-hidden">Mark dimensions, in units of a 1000-unit triangle side</caption>
        <tbody>
          {markSpec.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
        </tbody>
      </table>
    </div>
  </Section>

  <Section
    id="lockup"
    heading="Lockup"
    intro="The wordmark block is scaled as a unit to span the mark: the top of the r in arize is flush with the top of the triangle, and the foot of the l in labs with its bottom edge. arize and labs are drawn artwork, stacked and centred, and never retyped."
  >
    <div class="construct">
      <figure class="panel paper">
        <div class="stage tall">
          <svg class="diagram" viewBox={lockupFrame} role="img" aria-label="Lockup construction: the wordmark spans the mark, flush with its top and bottom edges">
            <g class="guides">
              <rect class="dash" x={L.x} y={L.y} width={L.w} height={L.h} />
              <line x1={markRight} y1={L.y - 40} x2={markRight} y2={L.y + L.h + 40} />
              <line x1={textLeft} y1={L.y - 40} x2={textLeft} y2={L.y + L.h + 40} />
            </g>
            <BrandArt name="lockup" nested />
            <g class="guides">
              <line class="accent" x1={L.x - 40} y1={markTop} x2={L.x + L.w + 40} y2={markTop} />
              <line class="accent" x1={L.x - 40} y1={lockup.bottom} x2={L.x + L.w + 40} y2={lockup.bottom} />
            </g>
            <g class="labels" font-size="34">
              <text x={(markRight + textLeft) / 2} y={L.y + L.h + 76} text-anchor="middle">{fmt(lockup.gap, 0)}</text>
              <text x={L.x + L.w + 40} y={markTop - 20} text-anchor="end">top = mark top</text>
              <text x={L.x + L.w + 40} y={lockup.bottom + 48} text-anchor="end">bottom = mark bottom</text>
            </g>
          </svg>
        </div>
        <figcaption><b>C-02</b> Lockup construction</figcaption>
      </figure>
      <table class="spec">
        <caption class="visually-hidden">Lockup dimensions, in the mark’s units</caption>
        <tbody>
          {lockupSpec.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
        </tbody>
      </table>
    </div>
  </Section>

  <Section
    id="space"
    heading="Clear space & minimum size"
    intro={`Keep a clear margin of one bore diameter (d) on every side. Never show the mark alone below ${minimumSize.mark} px, or the lockup below ${minimumSize.lockup} px tall.`}
  >
    <div class="grid two">
      <figure class="panel paper">
        <div class="stage">
          <svg class="diagram" viewBox={spaceFrame} role="img" aria-label="Clear space of one bore diameter on every side of the lockup">
            <g class="guides">
              <rect class="dash" x={L.x - d} y={L.y - d} width={L.w + 2 * d} height={L.h + 2 * d} />
              <rect class="strong" x={L.x} y={L.y} width={L.w} height={L.h} />
            </g>
            <BrandArt name="lockup" nested />
            <g class="labels" font-size="56" text-anchor="middle">
              {spaceLabels.map(([x, y]) => <text x={x} y={y + 15}>d</text>)}
            </g>
          </svg>
        </div>
        <figcaption><b>S-01</b> Clear space = d</figcaption>
      </figure>
      <figure class="panel paper">
        <div class="stage ladder">
          {ladder.map((px) => <BrandArt name="mark" style={`height:${px}px;width:auto`} />)}
        </div>
        <figcaption><b>S-02</b> {ladder.join(" · ")} px</figcaption>
      </figure>
    </div>
  </Section>

  <Section
    id="color"
    heading="Colour"
    intro="The mark is a single colour, with no accent and no gradient. Use whichever pairing has more contrast with the ground."
  >
    <ul class="grid four swatches">
      {swatches.map((s) => <li class:list={["swatch", s.class]}><b>{s.name}</b><span>{s.hex}</span></li>)}
    </ul>
    <div class="grid four tiles">
      <div class="tile ink"><BrandArt name="mark" /></div>
      <div class="tile paper"><BrandArt name="mark" /></div>
      <div class="tile ink round"><BrandArt name="mark" /></div>
      <div class="tile paper round"><BrandArt name="mark" /></div>
    </div>
  </Section>

  <Section
    id="type"
    heading="Typography"
    intro="Urbanist is the brand display face. The wordmark is drawn artwork, not set in it. Interface labels, indices and specifications are set in monospace."
  >
    <div class="specimen">
      <p class="big" aria-hidden="true">Aa</p>
      <ul class="weights">
        {weights.map(([w, name]) => (
          <li style={`font-weight:${w}`}>
            Aa<small>{w} · {name}</small>
          </li>
        ))}
      </ul>
      <p class="mono-sample">L-01 · 1000 u · Urbanist 600</p>
    </div>
  </Section>

  <Section id="misuse" heading="Misuse">
    <ul class="grid three misuse">
      {misuse.map((m) => (
        <li class:list={["misuse-tile", m.class]}>
          <div class="stage"><BrandArt name={m.art ?? "lockup"} /></div>
          <p>{m.caption}</p>
        </li>
      ))}
    </ul>
  </Section>
</PageLayout>

<style>
  .contents ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
    counter-reset: section;
  }
  .contents li { counter-increment: section; }
  .contents a {
    color: var(--dim);
    font: 500 var(--text-micro) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    text-decoration: none;
  }
  .contents a::before { content: counter(section, decimal-leading-zero) " "; }
  .contents a:hover, .contents a:focus-visible { color: var(--fg); }

  .hero { padding: var(--space-7) 0; border-top: 1px solid var(--fg); }
  .hero :global(svg) { max-width: 880px; }
  .downloads { display: flex; flex-wrap: wrap; gap: var(--space-2); padding: 0; list-style: none; }
  .note { margin-top: var(--space-3); color: var(--dim); font-size: var(--text-small); }

  .grid { display: grid; gap: var(--space-4); padding: 0; list-style: none; }
  .two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .four { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  /* Panels keep a fixed ground in both themes, so artwork is always shown as specified. */
  .panel { display: flex; flex-direction: column; border: 1px solid var(--rule); }
  .panel.paper { background: #fff; color: var(--color-ink); }
  .panel.ink { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .stage { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 240px; padding: var(--space-6); }
  .stage.tall { min-height: 460px; }
  .stage :global(.lockup) { max-width: 420px; }
  .stage :global(.mark-lg) { width: 120px; }

  figcaption, .spec th, .swatch span, .weights small, .mono-sample {
    font: 500 var(--text-micro) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
  }
  figcaption { padding: 10px 14px; border-top: 1px solid var(--rule); color: var(--dim); }
  figcaption b { margin-right: var(--space-2); padding: 2px 6px; background: var(--color-ink); color: var(--color-paper); font-weight: 500; }
  .panel.ink figcaption { border-color: #4a4545; color: #aaa49c; }
  .panel.ink figcaption b { background: var(--color-paper); color: var(--color-ink); }

  /* Construction diagrams */
  .diagram { width: 100%; max-width: 640px; height: auto; overflow: visible; }
  .guides { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0.35; }
  .guides :global(*) { vector-effect: non-scaling-stroke; }
  .guides .strong { opacity: 1; stroke-opacity: 0.8; }
  .guides .dash { stroke-dasharray: 4 4; }
  .guides .accent { stroke: var(--color-signal); stroke-width: 1.5; }
  .diagram .guides:has(.accent) { opacity: 1; }
  .labels { fill: currentColor; font-family: var(--font-mono); }
  .diagram :global(.ghost g) { fill-opacity: 0.12; stroke: currentColor; stroke-width: 1.5; }
  .diagram :global(.ghost path) { vector-effect: non-scaling-stroke; }

  .construct { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 1fr); gap: var(--space-4); align-items: start; }
  .spec { width: 100%; border-collapse: collapse; font: 13px / 1.3 var(--font-mono); }
  .spec th { padding: 11px 0; border-bottom: 1px solid var(--rule); color: var(--dim); font-weight: 400; text-align: left; }
  .spec td { padding: 11px 0 11px var(--space-4); border-bottom: 1px solid var(--rule); text-align: right; font-variant-numeric: tabular-nums; }
  .spec tr:first-child > * { border-top: 1px solid var(--fg); }

  .ladder { align-items: flex-end; flex-wrap: wrap; gap: 22px; }

  /* Colour */
  .swatch { display: flex; flex-direction: column; justify-content: flex-end; height: 150px; padding: 14px; border: 1px solid var(--rule); }
  .swatch b { font: 600 22px / 1.1 var(--font-sans); }
  .tiles { margin-top: var(--space-4); }
  .tile { display: grid; place-items: center; aspect-ratio: 1; border: 1px solid var(--rule); }
  .tile :global(svg) { width: 48px; }
  .tile.round { border-radius: 50%; }
  .ink { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .paper { background: var(--color-paper); color: var(--color-ink); }
  .white { background: #fff; color: var(--color-ink); }
  .black { background: #000; color: #fff; border-color: #000; }

  /* Typography */
  .specimen { padding-top: var(--space-5); border-top: 1px solid var(--fg); }
  .big { font: 600 clamp(120px, 22vw, 280px) / 1 var(--font-sans); }
  .weights {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }
  .weights li { padding-bottom: var(--space-2); border-bottom: 2px solid transparent; font-size: clamp(28px, 3.4vw, 48px); line-height: 1.1; }
  .weights small { display: block; color: var(--dim); line-height: 1.8; }
  .mono-sample { margin-top: var(--space-6); color: var(--soft); }

  /* Misuse */
  .misuse-tile { display: flex; flex-direction: column; border: 1px solid var(--rule); background: #fff; color: var(--color-ink); }
  .misuse-tile .stage { position: relative; min-height: 200px; overflow: hidden; }
  .misuse-tile .stage :global(svg) { max-width: 260px; }
  .misuse-tile p { display: flex; gap: var(--space-2); padding: 10px 14px; border-top: 1px solid var(--rule); color: var(--dim); font-size: var(--text-small); }
  .misuse-tile p::before { content: "✕"; color: var(--color-ink); }
  .misuse-tile.stretch .stage :global(svg) { max-width: 180px; transform: scaleX(1.35); }
  .rotate :global(svg) { transform: rotate(-14deg); }
  .recolour :global(svg) { color: #ff13ab; }
  .outline .stage :global(svg) { width: 140px; overflow: visible; }
  .outline :global(g) { fill: none; stroke: currentColor; stroke-width: 14; }
  .shadow :global(svg) { filter: drop-shadow(8px 10px 6px rgb(0 0 0 / 0.45)); }
  .low-contrast .stage { background: #7d7873; color: #6f6a65; }

  @media (max-width: 840px) {
    .construct, .two, .three { grid-template-columns: minmax(0, 1fr); }
    .four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .weights { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 720px) {
    .stage { padding: var(--space-5); }
    .stage.tall { min-height: 320px; }
  }
</style>
