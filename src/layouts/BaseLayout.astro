---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CodeCopy from "../components/CodeCopy.astro";
import Lightbox from "../components/lightbox/Lightbox.astro";
import type { Props as HeadProps } from "../components/BaseHead.astro";
import { site } from "../site.config";

export type Props = HeadProps;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <BaseHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="page-grid">
      <slot />
    </main>
    <Footer />
    <CodeCopy />
    <Lightbox />
  </body>
</html>

<style>
  .skip-link { position: absolute; left: var(--space-4); top: -100px; z-index: 20; padding: var(--space-2) var(--space-3); background: var(--fg); color: var(--bg); }
  .skip-link:focus { top: var(--space-2); }
</style>
