---
import BaseLayout from "./BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import type { Props as BaseProps } from "./BaseLayout.astro";

/**
 * Interior pages: a page title and intro above the content. Reading pages
 * (mission, credits) pass `width="prose"` to centre the header and content
 * in the same column as a blog post; see DESIGN.md ("Page types").
 * The `header` slot adds extras under the intro (a tag nav, a back link).
 */
export interface Props extends BaseProps {
  heading: string;
  intro?: string;
  eyebrow?: string;
  width?: "content" | "prose";
}
const { heading, intro, eyebrow, width = "content", ...rest } = Astro.props;
---

<BaseLayout title={heading} description={intro} {...rest}>
  <PageHeader heading={heading} intro={intro} eyebrow={eyebrow} width={width}>
    <slot name="header" />
  </PageHeader>
  {width === "prose" ? <div class="reading-column"><slot /></div> : <slot />}
</BaseLayout>
